# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# the old local SQLite file, kept as a backup of the pre-Postgres books
dev.db
dev.db-journal

.vercel
.env*

# next dev output when the server is started in the background
dev.log

# Vendored AI-agent skill packs (Prisma/Neon docs mirrored for three tools).
# Regenerated by tooling, not project source.
/.agents/
/.claude/
/.windsurf/
/skills-lock.json

# The template IS meant to be committed; the .env* rule above would swallow it.
!.env.example

# Local Netlify folder
.netlify

# Netlify's edge-function bundler (Deno) writes this during a local build.
deno.lock

# Firebase CLI debug output.
firebase-debug.log

# Firebase emulator artifacts
firestore-debug.log
ui-debug.log
firestore-export/
.firebase/

# Local copy of the generated App Hosting session secret (also in Secret Manager)
.firebase-session-secret.local
apphosting-debug.log
