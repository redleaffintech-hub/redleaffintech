# PostgreSQL connection string (§29).
#
# Use the POOLED connection string in DATABASE_URL — on serverless, every
# instance opens its own connections, and the pooler is what stops a busy
# moment from exhausting the database's connection limit.
#
# Neon pooled URLs contain "-pooler" in the host and need sslmode=require.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# ── Migrations ──────────────────────────────────────────────────────────────
# The DIRECT (unpooled) URL. `prisma migrate` takes a session advisory lock,
# which is not reliably held through a connection pooler — running a migration
# over the pooled URL fails with P1002 and leaves the lock stuck in PgBouncer.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# ── Public site ─────────────────────────────────────────────────────────────
# Canonical origin, used by sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL="https://redleaffintech.com"

# Address published on /contact and offered as the fallback when the contact
# form has nowhere to post.
CONTACT_EMAIL="hello@redleaffintech.com"

# Where /contact submissions are forwarded. Any endpoint that accepts a JSON
# POST — an email relay, a form service, a Slack webhook. While this is unset
# the form tells the visitor to email CONTACT_EMAIL instead of pretending the
# message was delivered.
CONTACT_FORWARD_URL=""

# ── Demo mode ───────────────────────────────────────────────────────────────
# Set to 1 to list the seeded accounts on the sign-in page with the password
# pre-filled. NEVER set this in production: it enumerates every user in the
# database. Leave unset (or anything other than 1) and the list is not queried.
DEMO_ACCOUNTS=""
