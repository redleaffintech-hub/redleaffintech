{
  "name": "redleaf-fintech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "deploy:firebase": "node scripts/deploy-firebase.mjs",
    "seed": "tsx prisma/seed.ts",
    "plans:seed": "node --conditions=react-server --import tsx scripts/seed-plans.ts",
    "admin:create": "node --conditions=react-server --import tsx scripts/create-platform-admin.ts",
    "user:create": "node --conditions=react-server --import tsx scripts/create-company-user.ts",
    "verify": "node --conditions=react-server --import tsx scripts/verify.ts",
    "migrate:firestore": "node --conditions=react-server --import tsx scripts/migrate-to-firestore.ts",
    "backfill:inventory-accounts": "node --conditions=react-server --import tsx scripts/backfill-inventory-accounts.ts",
    "backfill:company-modules": "node --conditions=react-server --import tsx scripts/backfill-company-modules.ts",
    "db:migrate": "prisma migrate deploy",
    "smoke:firestore": "node --conditions=react-server --import tsx scripts/smoke-firestore.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.6.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
